{
  "rewrites": [
    {
      "source": "/pedido",
      "destination": "/index.html"
    },
    {
      "source": "/pedido/",
      "destination": "/index.html"
    },
    {
      "source": "/natal",
      "destination": "/index.html"
    },
    {
      "source": "/natal/",
      "destination": "/index.html"
    },
    {
      "source": "/ensaio",
      "destination": "/index.html"
    },
    {
      "source": "/ensaio/",
      "destination": "/index.html"
    },
    {
      "source": "/ensaios",
      "destination": "/index.html"
    },
    {
      "source": "/ensaios/",
      "destination": "/index.html"
    },
    {
      "source": "/entrega/:codigo",
      "destination": "/index.html"
    },
    {
      "source": "/entrega/:codigo/",
      "destination": "/index.html"
    },
    {
      "source": "/orcamento/:codigo",
      "destination": "/index.html"
    },
    {
      "source": "/orcamento/:codigo/",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
